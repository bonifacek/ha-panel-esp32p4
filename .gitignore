# ESP-IDF build artifacts
build/
sdkconfig.old

# Managed components are downloaded automatically by idf.py
# Restore with: idf.py update-dependencies
managed_components/

# Python cache
**/__pycache__/
*.pyc

# Compiled firmware binaries (regenerated by build)
*.bin
*.elf
*.map

# Aplikacja pomocnicza (lokalne narzedzie konfiguracyjne — nie czesc firmware)
aplikacja/

# Claude Code local settings (permissions, cache)
.claude/

# Lokalny git config (ESP-IDF safe directory)
.codex_gitconfig

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Dokumentacja producenta (duze pliki PNG, schematy — nie potrzebne w repo)
Dokumentacja_producenta/
